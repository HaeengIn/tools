{# Define j2 Variables #}
{% set canonical = canonical | default("") %}
{% set title = title | default("") %}

<!DOCTYPE html>
<html lang="ko">
<head>
    {# Meta Settings #}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Link CSS Files #}
    <link rel="stylesheet" href="/static/css/reset.css?v={{ static_version('static/css/reset.css') }}">
    <link rel="stylesheet" href="/static/css/font.css?v={{ static_version('static/css/font.css') }}">
    {% if css_file %}
        {% for item in css_file %}
            <link rel="stylesheet" href="/static/css/{{ item }}?v={{ static_version('static/css/' + item) }}">
        {% endfor %}
    {% endif %}
    {% block css %}{% endblock css %}

    {# Canonical Setting #}
    <link rel="canonical" href="{{ canonical }}">

    {# Title of Page #}
    <title>{{ title }}</title>
</head>
<body>
    {# Render Navigation Bar #}
    {% include "nav-bar.j2" %}

    {# Main Contents #}
    <main>
        {% block body %}{% endblock body %}
    </main>

    {# Block for JavaScript #}
    {% if js_file %}
        {% for item in js_file %}
            <script src="/static/js/{{ item }}?v={{ static_version('static/js/' + item) }}"></script>
        {% endfor %}
    {% endif %}
    {% block script %}{% endblock script %}
</body>
</html>